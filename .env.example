DATABASE_URL=postgresql://greencity:greencity@localhost:5435/greencity
REDIS_URL=redis://localhost:6380
ADMIN_USERNAME=
ADMIN_PASSWORD=
BP_USERNAME=
BP_PASSWORD=
ERP_BASE_URL=http://app.greencity.org.in
PLAYWRIGHT_HEADLESS=true
SCRAPER_CONCURRENCY=2
SCRAPER_DELAY_MS=1500
GENEALOGY_CONCURRENCY=50
GENEALOGY_AUTH_MODE=direct_login
GENEALOGY_BP_ORDER=leaf_first
GENEALOGY_PARALLEL_TREES=true
GENEALOGY_PARALLEL_MODULES=true
GENEALOGY_ENQUEUE_STAGGER_MS=50
GENEALOGY_PORTAL_RETRY_ATTEMPTS=3
GENEALOGY_PORTAL_RETRY_MS=2000
SCRAPER_BROWSER_POOL=true
SCRAPER_BLOCK_RESOURCES=true
SCRAPER_ADMIN_CONTEXT=false
BP_HARVEST_QUEUE=true
GENEALOGY_ENABLED=true
# Speed targets:
# - Playwright (admin context): ~40-80 BP/min with GENEALOGY_CONCURRENCY=80
# - HTTP turbo: GENEALOGY_HTTP_HTML=true + GENEALOGY_HTTP_ONLY=true + GENEALOGY_HTTP_CONCURRENCY=200+
GENEALOGY_HTTP_ONLY=false
GENEALOGY_HTTP_HTML=false
GENEALOGY_HTTP_CONCURRENCY=200
GENEALOGY_HTTP_CONNECTIONS=300
# Discover via: GENEALOGY_INSPECT_BP=BP123 pnpm --filter @greencity/scraper inspect:genealogy
# Optional JSON XHR endpoint (leave empty when using GENEALOGY_HTTP_HTML)
GENEALOGY_HTTP_TREE_URL=
GENEALOGY_HTTP_COOKIE=
STORAGE_STATE_DIR=./.data/sessions
FAILURE_HTML_DIR=./.data/failures
DASHBOARD_PASSWORD=
PORT=3010

# Integration API (MLM ERP consumer)
INTEGRATION_API_KEY=
INTEGRATION_CORS_ORIGIN=https://mlm-erp.example.com
INTEGRATION_RATE_LIMIT_POINTS=500
INTEGRATION_RATE_LIMIT_DURATION=60
