{
  "name": "@greencity/scraper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && cp src/extractors/dom-grid.browser.js dist/extractors/",
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "start:genealogy": "node dist/genealogy-index.js",
    "run:bp-remaining": "node dist/run-bp-list-remaining.js",
    "renew:session": "node dist/cli-renew-session.js",
    "inspect:genealogy": "tsx src/cli-inspect-genealogy.ts",
    "inspect:http-harvest": "tsx src/cli-http-harvest.ts",
    "benchmark:parallel-trees": "tsx src/cli-benchmark-parallel-trees.ts",
    "benchmark:parallel-modules": "tsx src/cli-benchmark-parallel-modules.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@greencity/db": "workspace:*",
    "@greencity/queue": "workspace:*",
    "@greencity/scraper-core": "workspace:*",
    "@greencity/shared": "workspace:*",
    "bullmq": "^5.52.2",
    "ioredis": "^5.6.1",
    "playwright": "1.52.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
